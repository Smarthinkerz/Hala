# Hala — environment variables for an independent Vercel deploy.
# Copy to Vercel Project Settings → Environment Variables.
# Never commit real values. Never paste secrets into chat.

# Required for production (https://hala.eqence.com)
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://hala.eqence.com
VITE_AUTH_ENABLED=true

# SmarThinkerz Hub checkout. Tap keys stay on smarthinkerz.com, not on Hala.
# Catalog slugs: hala-essential ($300) / hala-plus ($600) / hala-premium ($1200)
# Partner webhook: POST /api/smarthinkerz/webhook
# Return: /checkout/return?ref=
SMARTHINKERZ_HUB_ORIGIN=https://smarthinkerz.com
SMARTHINKERZ_PARTNER_SECRET=

# Optional AI. Without this, Hala still answers from clinic knowledge.
XAI_API_KEY=
