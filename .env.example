# Hala — environment variables for an independent Vercel deploy.
# Copy to Vercel Project Settings → Environment Variables.
# Never commit real values. Never paste secrets into chat.

# ---------------------------------------------------------------------------
# Required for production (https://hala.eqence.com)
# ---------------------------------------------------------------------------

# Neon (or any Postgres) connection string. Server-only.
# Without this, Hala falls back to in-memory PGLite (preview only; data dies on restart).
# Obtain: https://console.neon.tech → project → connection string (pooled).
# Example: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Better Auth signing secret. Server-only. Generate: openssl rand -hex 32
# Required in production so sessions survive deploys.
BETTER_AUTH_SECRET=

# Public origin of this deployment. Server-only. No trailing slash.
# Must match the live URL clinics use.
BETTER_AUTH_URL=https://hala.eqence.com

# Enable clinic accounts. Client-safe. Must be "true" on Vercel.
VITE_AUTH_ENABLED=true

# ---------------------------------------------------------------------------
# Payments (Tap) — optional as env; you can also paste keys in Owner desk
# Server-only. Prefer env on Vercel so the secret is not only in the database.
# Obtain: https://tappayments.tappayments.com (or dashboard.tap.company)
# Secret starts with sk_test_ or sk_live_
# ---------------------------------------------------------------------------
TAP_SECRET_KEY=
TAP_PUBLIC_KEY=
TAP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI (optional). Server-only. Without this, Hala still answers from the local
# receptionist (clinic knowledge + real slots). Voice needs this key.
# Obtain: https://console.x.ai
# ---------------------------------------------------------------------------
XAI_API_KEY=

# ---------------------------------------------------------------------------
# Grok App Builder only — leave UNSET on your own Vercel.
# These let Google/X sign-in work inside the Grok preview via the Grok auth broker.
# Independent Hala uses email/password. Native Google/X on your Vercel is not
# wired yet (would need your own Google Cloud / X developer apps).
# ---------------------------------------------------------------------------
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# VITE_STUN_URLS=
